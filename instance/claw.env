# This deployment. Copy to instance/claw.env and commit it — it holds no secrets.
# Secrets go to .secrets/claw.env (ignored) or the profile's vault.
#
# Instance-owned: the boilerplate never changes instance/claw.env, only this example.

# Which hosting profile: local | azure | hetzner-cloudflare
CLAW_PROFILE=local

# Lowercase slug. Names the compose project, containers, network, image and
# the host data root (/srv/<instance> on hosted profiles).
# One claw per worktree collection: the collection name keeps containers,
# network and images apart (the data dir is per worktree already).
CLAW_INSTANCE=wtc-claw-${WTC_COLLECTION:-local}

# Public hostname (hosted profiles). Empty for local.
CLAW_HOSTNAME=

# Host-loopback operations port. Inside a worktree collection the harness
# assigns one per collection (WTC_CLAW_PORT in .env.collection), so several
# collections can each run their own claw side by side.
CLAW_PORT=${WTC_CLAW_PORT:-18789}

CLAW_TZ=Europe/Berlin

# People. JSON arrays of e-mail addresses.
#   CLAW_ACCESS_EMAILS  who may sign in (front door allowlist)
#   CLAW_ADMIN_EMAILS   who additionally gets operator.admin
CLAW_ACCESS_EMAILS='[]'
CLAW_ADMIN_EMAILS='[]'

# Upstream OpenClaw image the core image builds on. Pin it; bump by PR.
OPENCLAW_IMAGE=ghcr.io/openclaw/openclaw:2026.10.2-browser

# Registry for hosted profiles (image name without tag), e.g.
#   ghcr.io/<owner>/<repo>-openclaw    or   <registry>.azurecr.io/claw-openclaw
# CLAW_IMAGE_NAME=
